{
  "name": "xbridge",
  "displayName": "XBridge",
  "description": "Build, run, test and manage iOS/macOS Xcode projects and simulators directly from VS Code — with first-class AI agent tools.",
  "version": "1.3.0",
  "publisher": "mithlesh",
  "author": {
    "name": "Deepak Sharma"
  },
  "license": "MIT",
  "homepage": "https://marketplace.visualstudio.com/items?itemName=mithlesh.xbridge",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0A84FF",
    "theme": "dark"
  },
  "preview": false,
  "pricing": "Free",
  "qna": "marketplace",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "XBridge executes xcodebuild and xcrun commands from the current workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Xcode projects, build products and simulators require a local macOS file system."
    }
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Testing",
    "Other"
  ],
  "keywords": [
    "swift",
    "ios",
    "xcode",
    "xcodebuild",
    "simulator",
    "simctl",
    "swiftui",
    "xctest",
    "swift-testing",
    "ios-development",
    "mobile-development",
    "copilot-tools",
    "ai-agent"
  ],
  "activationEvents": [
    "workspaceContains:**/*.xcodeproj",
    "workspaceContains:**/*.xcworkspace",
    "workspaceContains:**/Package.swift",
    "onLanguage:swift"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "XBridge",
      "properties": {
        "xbridge.projectPath": {
          "type": "string",
          "default": "",
          "description": "Path to the .xcodeproj or .xcworkspace to use. Leave empty to auto-detect."
        },
        "xbridge.scheme": {
          "type": "string",
          "default": "",
          "description": "The default Xcode scheme to build/run/test."
        },
        "xbridge.configuration": {
          "type": "string",
          "default": "Debug",
          "description": "Build configuration (e.g. Debug, Release)."
        },
        "xbridge.destination": {
          "type": "string",
          "default": "",
          "description": "The selected simulator/device destination UDID. Leave empty to select interactively."
        },
        "xbridge.testPlan": {
          "type": "string",
          "default": "",
          "description": "The selected test plan (.xctestplan base name) to run. Leave empty to use the scheme's default."
        },
        "xbridge.testTarget": {
          "type": "string",
          "default": "",
          "description": "The selected test target to run. Leave empty to run all tests."
        },
        "xbridge.derivedDataPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Custom derivedData path. Leave empty to use the default under the workspace (.build/DerivedData)."
        },
        "xbridge.extraBuildArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments appended to every xcodebuild invocation."
        },
        "xbridge.streamAppLogs": {
          "type": "boolean",
          "default": true,
          "description": "Stream the launched app's console output into the 'XBridge App' output channel."
        },
        "xbridge.openSimulatorOnRun": {
          "type": "boolean",
          "default": true,
          "description": "Bring Simulator.app to the front when the app is launched."
        },
        "xbridge.autoRevealBuildLog": {
          "type": "boolean",
          "default": false,
          "description": "Open the build log panel automatically whenever a build, test or clean starts."
        }
      }
    },
    "commands": [
      {
        "command": "xbridge.build",
        "title": "Build",
        "category": "XBridge",
        "icon": "$(tools)"
      },
      {
        "command": "xbridge.clean",
        "title": "Clean Build Folder",
        "category": "XBridge",
        "icon": "$(trash)"
      },
      {
        "command": "xbridge.run",
        "title": "Build & Run",
        "category": "XBridge",
        "icon": "$(play)"
      },
      {
        "command": "xbridge.stop",
        "title": "Stop",
        "category": "XBridge",
        "icon": "$(debug-stop)"
      },
      {
        "command": "xbridge.stopApp",
        "title": "Stop Running App",
        "category": "XBridge",
        "icon": "$(debug-stop)"
      },
      {
        "command": "xbridge.test",
        "title": "Run Tests",
        "category": "XBridge",
        "icon": "$(beaker)"
      },
      {
        "command": "xbridge.selectScheme",
        "title": "Select Scheme",
        "category": "XBridge"
      },
      {
        "command": "xbridge.selectConfiguration",
        "title": "Select Build Configuration",
        "category": "XBridge"
      },
      {
        "command": "xbridge.selectDestination",
        "title": "Select Destination (Simulator/Device)",
        "category": "XBridge"
      },
      {
        "command": "xbridge.bootSimulator",
        "title": "Boot Simulator",
        "category": "XBridge",
        "icon": "$(vm-running)"
      },
      {
        "command": "xbridge.shutdownSimulator",
        "title": "Shutdown Simulator",
        "category": "XBridge",
        "icon": "$(vm-outline)"
      },
      {
        "command": "xbridge.openSimulatorApp",
        "title": "Open Simulator.app",
        "category": "XBridge",
        "icon": "$(device-mobile)"
      },
      {
        "command": "xbridge.eraseSimulator",
        "title": "Erase Simulator Content",
        "category": "XBridge"
      },
      {
        "command": "xbridge.refreshSimulators",
        "title": "Refresh Simulators",
        "category": "XBridge",
        "icon": "$(refresh)"
      },
      {
        "command": "xbridge.refreshSchemes",
        "title": "Refresh Schemes",
        "category": "XBridge",
        "icon": "$(refresh)"
      },
      {
        "command": "xbridge.showOutput",
        "title": "Show Build Output",
        "category": "XBridge",
        "icon": "$(output)"
      },
      {
        "command": "xbridge.selectTarget",
        "title": "Select Scheme, Configuration or Destination",
        "category": "XBridge",
        "icon": "$(target)"
      },
      {
        "command": "xbridge.selectProject",
        "title": "Select Xcode Project or Workspace",
        "category": "XBridge",
        "icon": "$(folder-opened)"
      },
      {
        "command": "xbridge.selectTestPlan",
        "title": "Select Test Plan",
        "category": "XBridge",
        "icon": "$(checklist)"
      },
      {
        "command": "xbridge.selectTestTarget",
        "title": "Select Test Target",
        "category": "XBridge",
        "icon": "$(beaker)"
      },
      {
        "command": "xbridge.showIssues",
        "title": "Show Build Issues",
        "category": "XBridge",
        "icon": "$(list-flat)"
      },
      {
        "command": "xbridge.showAppLog",
        "title": "Show App Console",
        "category": "XBridge",
        "icon": "$(terminal)"
      },
      {
        "command": "xbridge.setDestination",
        "title": "Set as Destination",
        "category": "XBridge",
        "icon": "$(pass)"
      },
      {
        "command": "xbridge.copySimulatorUdid",
        "title": "Copy Simulator UDID",
        "category": "XBridge",
        "icon": "$(copy)"
      },
      {
        "command": "xbridge.openUrlOnSimulator",
        "title": "Open URL or Deep Link…",
        "category": "XBridge",
        "icon": "$(link)"
      },
      {
        "command": "xbridge.screenshotSimulator",
        "title": "Take Screenshot",
        "category": "XBridge",
        "icon": "$(device-camera)"
      },
      {
        "command": "xbridge.toggleRecording",
        "title": "Start / Stop Screen Recording",
        "category": "XBridge",
        "icon": "$(record)"
      },
      {
        "command": "xbridge.toggleAppearance",
        "title": "Toggle Light / Dark Appearance",
        "category": "XBridge",
        "icon": "$(color-mode)"
      },
      {
        "command": "xbridge.openAppContainer",
        "title": "Open App Data Container",
        "category": "XBridge",
        "icon": "$(folder-opened)"
      },
      {
        "command": "xbridge.uninstallApp",
        "title": "Uninstall App from Simulator",
        "category": "XBridge",
        "icon": "$(trash)"
      },
      {
        "command": "xbridge.openWalkthrough",
        "title": "Getting Started",
        "category": "XBridge",
        "icon": "$(book)"
      }
    ],
    "keybindings": [
      {
        "command": "xbridge.build",
        "key": "ctrl+cmd+b",
        "mac": "ctrl+cmd+b",
        "when": "xbridge.hasProject && !xbridge.running"
      },
      {
        "command": "xbridge.run",
        "key": "ctrl+cmd+r",
        "mac": "ctrl+cmd+r",
        "when": "xbridge.hasProject && !xbridge.running"
      },
      {
        "command": "xbridge.test",
        "key": "ctrl+cmd+u",
        "mac": "ctrl+cmd+u",
        "when": "xbridge.hasProject && !xbridge.running"
      },
      {
        "command": "xbridge.clean",
        "key": "ctrl+cmd+k",
        "mac": "ctrl+cmd+k",
        "when": "xbridge.hasProject && !xbridge.running"
      },
      {
        "command": "xbridge.stop",
        "key": "ctrl+cmd+.",
        "mac": "ctrl+cmd+.",
        "when": "xbridge.running || xbridge.appRunning"
      },
      {
        "command": "xbridge.selectDestination",
        "key": "ctrl+cmd+d",
        "mac": "ctrl+cmd+d",
        "when": "xbridge.hasProject"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xbridge",
          "title": "XBridge",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "xbridge": [
        {
          "id": "xbridge.schemes",
          "name": "Build & Run",
          "icon": "$(target)",
          "contextualTitle": "XBridge"
        },
        {
          "id": "xbridge.simulators",
          "name": "Simulators",
          "icon": "$(device-mobile)",
          "contextualTitle": "XBridge"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "xbridge.schemes",
        "when": "!xbridge.hasProject",
        "contents": "No Xcode project or workspace was found in this folder.\n\n[Select Xcode Project…](command:xbridge.selectProject)\n\nOpen a folder that contains an `.xcodeproj`, `.xcworkspace`, or `Package.swift`, or pick one manually above.\n\n[Take the tour](command:xbridge.openWalkthrough)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "xbridge.setDestination",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "xbridge.run",
          "when": "view == xbridge.schemes && !xbridge.running",
          "group": "navigation@1"
        },
        {
          "command": "xbridge.stop",
          "when": "view == xbridge.schemes && xbridge.running",
          "group": "navigation@1"
        },
        {
          "command": "xbridge.build",
          "when": "view == xbridge.schemes && !xbridge.running",
          "group": "navigation@2"
        },
        {
          "command": "xbridge.test",
          "when": "view == xbridge.schemes && !xbridge.running",
          "group": "navigation@3"
        },
        {
          "command": "xbridge.stopApp",
          "when": "view == xbridge.schemes && xbridge.appRunning",
          "group": "navigation@4"
        },
        {
          "command": "xbridge.refreshSchemes",
          "when": "view == xbridge.schemes",
          "group": "navigation@5"
        },
        {
          "command": "xbridge.clean",
          "when": "view == xbridge.schemes && !xbridge.running",
          "group": "1_build@1"
        },
        {
          "command": "xbridge.showOutput",
          "when": "view == xbridge.schemes",
          "group": "1_build@2"
        },
        {
          "command": "xbridge.showAppLog",
          "when": "view == xbridge.schemes",
          "group": "1_build@3"
        },
        {
          "command": "xbridge.showIssues",
          "when": "view == xbridge.schemes",
          "group": "1_build@4"
        },
        {
          "command": "xbridge.selectScheme",
          "when": "view == xbridge.schemes",
          "group": "2_config@1"
        },
        {
          "command": "xbridge.selectConfiguration",
          "when": "view == xbridge.schemes",
          "group": "2_config@2"
        },
        {
          "command": "xbridge.selectDestination",
          "when": "view == xbridge.schemes",
          "group": "2_config@3"
        },
        {
          "command": "xbridge.selectTestPlan",
          "when": "view == xbridge.schemes",
          "group": "2_config@4"
        },
        {
          "command": "xbridge.selectTestTarget",
          "when": "view == xbridge.schemes",
          "group": "2_config@5"
        },
        {
          "command": "xbridge.selectProject",
          "when": "view == xbridge.schemes",
          "group": "3_project@1"
        },
        {
          "command": "xbridge.refreshSimulators",
          "when": "view == xbridge.simulators",
          "group": "navigation@1"
        },
        {
          "command": "xbridge.openSimulatorApp",
          "when": "view == xbridge.simulators",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "xbridge.bootSimulator",
          "when": "view == xbridge.simulators && viewItem =~ /\\.shutdown\\./",
          "group": "inline@1"
        },
        {
          "command": "xbridge.shutdownSimulator",
          "when": "view == xbridge.simulators && viewItem =~ /\\.booted\\./",
          "group": "inline@1"
        },
        {
          "command": "xbridge.screenshotSimulator",
          "when": "view == xbridge.simulators && viewItem =~ /\\.booted\\./",
          "group": "inline@2"
        },
        {
          "command": "xbridge.setDestination",
          "when": "view == xbridge.simulators && viewItem =~ /\\.unselected\\./",
          "group": "1_destination@1"
        },
        {
          "command": "xbridge.bootSimulator",
          "when": "view == xbridge.simulators && viewItem =~ /\\.shutdown\\./",
          "group": "1_destination@2"
        },
        {
          "command": "xbridge.shutdownSimulator",
          "when": "view == xbridge.simulators && viewItem =~ /\\.booted\\./",
          "group": "1_destination@2"
        },
        {
          "command": "xbridge.openUrlOnSimulator",
          "when": "view == xbridge.simulators && viewItem =~ /^simulator\\./",
          "group": "2_device@1"
        },
        {
          "command": "xbridge.screenshotSimulator",
          "when": "view == xbridge.simulators && viewItem =~ /\\.booted\\./",
          "group": "2_device@2"
        },
        {
          "command": "xbridge.toggleRecording",
          "when": "view == xbridge.simulators && viewItem =~ /\\.booted\\./",
          "group": "2_device@3"
        },
        {
          "command": "xbridge.toggleAppearance",
          "when": "view == xbridge.simulators && viewItem =~ /\\.booted\\./",
          "group": "2_device@4"
        },
        {
          "command": "xbridge.openAppContainer",
          "when": "view == xbridge.simulators && viewItem =~ /\\.booted\\./",
          "group": "3_app@1"
        },
        {
          "command": "xbridge.uninstallApp",
          "when": "view == xbridge.simulators && viewItem =~ /\\.booted\\./",
          "group": "3_app@2"
        },
        {
          "command": "xbridge.copySimulatorUdid",
          "when": "view == xbridge.simulators && viewItem =~ /^simulator\\./",
          "group": "8_copy@1"
        },
        {
          "command": "xbridge.eraseSimulator",
          "when": "view == xbridge.simulators && viewItem =~ /^simulator\\./",
          "group": "9_danger@1"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "xbridge_build",
        "displayName": "Build iOS Project",
        "modelDescription": "Builds the current Xcode project or workspace using xcodebuild for a given scheme and destination. Returns the build status and any compiler errors/warnings. Use this to verify that Swift/Objective-C code compiles.",
        "userDescription": "Build the iOS project with xcodebuild",
        "toolReferenceName": "iosBuild",
        "canBeReferencedInPrompt": true,
        "icon": "$(tools)",
        "tags": [
          "ios",
          "xcode",
          "build"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "scheme": {
              "type": "string",
              "description": "The Xcode scheme to build. Optional; defaults to the currently selected scheme."
            },
            "configuration": {
              "type": "string",
              "description": "Build configuration such as Debug or Release. Optional."
            },
            "destinationId": {
              "type": "string",
              "description": "Simulator/device UDID to build for. Optional; defaults to the selected destination."
            }
          }
        }
      },
      {
        "name": "xbridge_test",
        "displayName": "Run iOS Tests",
        "modelDescription": "Runs the unit/UI tests of the current Xcode project using 'xcodebuild test'. Returns pass/fail summary and failing test details. Optionally filter to a specific test target, class, or method via testIdentifier (e.g. 'MyAppTests/LoginTests/testValidLogin').",
        "userDescription": "Run iOS tests with xcodebuild",
        "toolReferenceName": "iosTest",
        "canBeReferencedInPrompt": true,
        "icon": "$(beaker)",
        "tags": [
          "ios",
          "xcode",
          "test"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "scheme": {
              "type": "string",
              "description": "The scheme whose tests to run. Optional; defaults to the selected scheme."
            },
            "destinationId": {
              "type": "string",
              "description": "Simulator UDID to run tests on. Optional; defaults to the selected destination."
            },
            "testIdentifier": {
              "type": "string",
              "description": "Optional single test/target/class identifier to run, e.g. 'MyAppTests/LoginTests/testValidLogin'."
            }
          }
        }
      },
      {
        "name": "xbridge_run",
        "displayName": "Run iOS App on Simulator",
        "modelDescription": "Builds the app, installs it on the selected iOS simulator (booting it if needed), and launches it. Returns the launch status and the app bundle identifier.",
        "userDescription": "Build, install and launch the app on a simulator",
        "toolReferenceName": "iosRun",
        "canBeReferencedInPrompt": true,
        "icon": "$(play)",
        "tags": [
          "ios",
          "xcode",
          "simulator",
          "run"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "scheme": {
              "type": "string",
              "description": "The scheme to run. Optional; defaults to the selected scheme."
            },
            "destinationId": {
              "type": "string",
              "description": "Simulator UDID to run on. Optional; defaults to the selected destination."
            }
          }
        }
      },
      {
        "name": "xbridge_listSchemes",
        "displayName": "List Xcode Schemes",
        "modelDescription": "Lists all schemes, targets and configurations available in the current Xcode project or workspace. Use this to discover valid scheme names before building, running or testing.",
        "userDescription": "List available Xcode schemes and targets",
        "toolReferenceName": "iosSchemes",
        "canBeReferencedInPrompt": true,
        "icon": "$(target)",
        "tags": [
          "ios",
          "xcode"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "xbridge_listSimulators",
        "displayName": "List iOS Simulators",
        "modelDescription": "Lists available iOS simulators grouped by runtime, including their name, UDID and boot state. Use this to discover valid destination UDIDs.",
        "userDescription": "List available iOS simulators",
        "toolReferenceName": "iosSimulators",
        "canBeReferencedInPrompt": true,
        "icon": "$(device-mobile)",
        "tags": [
          "ios",
          "simulator"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "availableOnly": {
              "type": "boolean",
              "description": "If true, only include simulators that are currently available. Defaults to true."
            }
          }
        }
      },
      {
        "name": "xbridge_bootSimulator",
        "displayName": "Boot iOS Simulator",
        "modelDescription": "Boots an iOS simulator by UDID (or the selected destination) so that apps can be installed and launched on it.",
        "userDescription": "Boot an iOS simulator",
        "toolReferenceName": "iosBoot",
        "canBeReferencedInPrompt": true,
        "icon": "$(vm-running)",
        "tags": [
          "ios",
          "simulator"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "udid": {
              "type": "string",
              "description": "UDID of the simulator to boot. Optional; defaults to the selected destination."
            }
          }
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "xbridge.welcome",
        "title": "Get started with XBridge",
        "description": "Build, run and test your iOS app on a simulator without leaving VS Code.",
        "when": "isMac",
        "steps": [
          {
            "id": "xbridge.walkthrough.project",
            "title": "Pick your project",
            "description": "XBridge auto-detects an .xcodeproj, .xcworkspace or Package.swift in your folder. If you have several, choose one.\n[Select Xcode Project](command:xbridge.selectProject)",
            "media": {
              "markdown": "media/walkthrough/project.md"
            },
            "completionEvents": [
              "onCommand:xbridge.selectProject"
            ]
          },
          {
            "id": "xbridge.walkthrough.destination",
            "title": "Choose a simulator",
            "description": "Open the XBridge view in the Activity Bar and click any simulator to make it your run destination — booted devices are listed first.\n[Select Destination](command:xbridge.selectDestination)",
            "media": {
              "markdown": "media/walkthrough/destination.md"
            },
            "completionEvents": [
              "onCommand:xbridge.selectDestination",
              "onCommand:xbridge.setDestination"
            ]
          },
          {
            "id": "xbridge.walkthrough.run",
            "title": "Build and run",
            "description": "Hit Run to build, install and launch on the simulator. The app's console streams into the XBridge App output channel.\n[Build & Run](command:xbridge.run)",
            "media": {
              "markdown": "media/walkthrough/run.md"
            },
            "completionEvents": [
              "onCommand:xbridge.run"
            ]
          },
          {
            "id": "xbridge.walkthrough.ai",
            "title": "Let Copilot drive Xcode",
            "description": "Reference #iosBuild, #iosTest or #iosRun in Copilot Chat and the agent can compile your Swift code, run tests and read back the failures.\n[Open Chat](command:workbench.action.chat.open)",
            "media": {
              "markdown": "media/walkthrough/ai.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "test": "tsx --test test/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.23.12",
    "typescript": "^5.5.2"
  }
}
